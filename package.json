{
  "name": "accessmate-ai",
  "version": "1.1.0",
  "description": "AccessMate AI – Your Accessibility Companion. AI-powered app for people with visual, hearing, and reading difficulties.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --verbose --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit --verbose --forceExit",
    "test:integration": "jest tests/integration --verbose --forceExit",
    "test:coverage": "jest --coverage --verbose --forceExit --detectOpenHandles",
    "test:report": "jest --verbose --forceExit --detectOpenHandles --json --outputFile=test-results.json"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "hpp": "^0.2.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "keywords": ["accessibility", "ai", "gemini", "assistive-technology"],
  "license": "MIT"
}
